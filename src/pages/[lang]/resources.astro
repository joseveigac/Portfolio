---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { difficultyColors, categoryLabels, difficultyLabels } from '../../lib/theme';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() {
	return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const lang = getLangFromUrl(Astro.url);
const dateLocale = lang === 'es' ? 'es-ES' : 'en-US';

const T = {
	en: {
		title: 'Resources - Jose Veiga',
		description: 'Guides, tutorials and development notes',
		heading: 'Resources',
		sub: 'Guides, tutorials, and development notes to help other developers',
		preview: 'Preview',
		minRead: 'min read',
		readMore: 'Read More',
	},
	es: {
		title: 'Recursos - Jose Veiga',
		description: 'Guías, tutoriales y notas de desarrollo',
		heading: 'Recursos',
		sub: 'Guías, tutoriales y notas de desarrollo para ayudar a otros desarrolladores',
		preview: 'Vista previa',
		minRead: 'min de lectura',
		readMore: 'Leer más',
	},
}[lang];

const resources = await getCollection('resources');
const sortedResources = resources
	.filter((r: any) => r.id.startsWith(`${lang}/`))
	.sort((a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={T.title} description={T.description}>
	<main class="pt-24 pb-16 px-4 max-w-6xl mx-auto">
		<div class="mb-12">
			<h1 class="text-white text-3xl md:text-4xl font-bold">{T.heading}</h1>
			<div class="w-full h-1 bg-sky-400 mt-4"></div>
			<p class="text-neutral-400 mt-4">{T.sub}</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
			{sortedResources.map((resource: any) => (
                <article class="relative border border-neutral-700/50 rounded-lg overflow-hidden bg-neutral-900/40 hover:border-neutral-600 transition-colors group cursor-pointer">
                    <a href={getRelativeLocaleUrl(lang, `/resources/${resource.id.slice(lang.length + 1)}`)} class="absolute inset-0 z-10"></a>
                    <div class="relative overflow-hidden">
                        <img
                            src={resource.data.image}
                            alt={resource.data.title}
                            class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <!-- Category badge (izquierda) -->
                        <span class="absolute top-3 left-3 text-xs px-2 py-1 bg-sky-500/90 text-white rounded-md font-medium">
                            {categoryLabels[lang][resource.data.category]}
                        </span>
                        <!-- Difficulty badge (derecha) -->
                        <span class={`absolute top-3 right-3 text-xs px-2 py-1 text-white rounded-md font-medium ${difficultyColors[resource.data.difficulty]}`}>
                            {difficultyLabels[lang][resource.data.difficulty]}
                        </span>
                        {resource.data.wip && (
                            <span class="absolute bottom-3 left-3 z-10 text-[11px] px-2.5 py-1 bg-amber-500/18 text-amber-300 rounded-full font-semibold backdrop-blur-md">
                                {T.preview}
                            </span>
                        )}
                    </div>
                    <div class="p-5">
                        <div class="flex items-center gap-2 text-xs text-neutral-500 mb-2">
                            <span>{resource.data.date.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                            <span>·</span>
                            <span>{resource.data.readTime} {T.minRead}</span>
                        </div>
                        <h3 class="text-lg font-semibold mb-2 group-hover:text-sky-400 transition-colors">{resource.data.title}</h3>
                        <p class="text-sm text-neutral-400 mb-4 line-clamp-2">{resource.data.description}</p>
                        <ul class="flex flex-wrap gap-2 mb-4">
                            {resource.data.tags.slice(0, 3).map((tag: string) => (
                                <li class="text-xs px-2 py-1 bg-neutral-800 rounded-md text-neutral-300">{tag}</li>
                            ))}
                        </ul>
                        <div class="relative z-20">
                            <Button href={getRelativeLocaleUrl(lang, `/resources/${resource.id.slice(lang.length + 1)}`)} variant="ghost" size="sm" rounded="md">
                                {T.readMore}
                            </Button>
                        </div>
                    </div>
                </article>
			))}
		</div>
	</main>
</Layout>
