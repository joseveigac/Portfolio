---
import ProjectsIcon   from "../icons/ProjectsIcon.astro";
import Unity          from "../icons/Unity.astro";
import Flutter        from "../icons/Flutter.astro";
import AstroIcon      from "../icons/AstroIcon.astro";
import MinecraftWhite from "../icons/MinecraftWhite.astro";
import { serviceColors } from "../lib/theme";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const T = {
    en: { eyebrow: 'What I Do', heading: 'Four areas, one developer.', sub: 'For studios, founders, and small businesses.' },
    es: { eyebrow: 'Lo que hago', heading: 'Cuatro áreas, un desarrollador.', sub: 'Para estudios, fundadores y pequeñas empresas.' },
}[lang];

const AREAS = [
    { title: { en: 'Bedrock Add-ons', es: 'Add-ons de Bedrock' }, desc: { en: 'Minecraft Marketplace-ready content. Script API v2 + TypeScript.', es: 'Minecraft Bedrock Add-ons, listos para publicar con TypeScript.' }, href: '/services/bedrock',  kind: 'cube',    type: 'bedrock', cta: { en: 'Start a Bedrock project →', es: 'Empieza un proyecto de Bedrock →' } },
    { title: { en: 'Unity development', es: 'Desarrollo en Unity' }, desc: { en: 'Game programming and production. Steam-shipped contributor.', es: 'Programación y producción de juegos. Contribuidor con títulos en Steam.' }, href: '/services/unity',    kind: 'unity',   type: 'unity',   cta: { en: 'Start a Unity project →', es: 'Empieza un proyecto Unity →' } },
    { title: { en: 'Flutter apps', es: 'Apps Flutter' }, desc: { en: 'Cross-platform mobile from a single codebase. iOS + Android.', es: 'Móvil multiplataforma desde un único código. iOS + Android.' }, href: '/services/flutter',  kind: 'flutter', type: 'flutter', cta: { en: 'Start a Flutter project →', es: 'Empieza un proyecto Flutter →' } },
    { title: { en: 'Websites', es: 'Webs' }, desc: { en: 'Portfolios, landing pages, marketing sites for small businesses.', es: 'Porfolios, landing pages y webs de marketing para pequeñas empresas.' }, href: '/services/websites', kind: 'astro',   type: 'web',     cta: { en: 'Start a website project →', es: 'Empieza un proyecto web →' } },
];
---

<section id="what-i-do" class="relative w-full bg-neutral-950 py-24 border-b border-neutral-800/60 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.35]" style="background-image: radial-gradient(ellipse at 80% 20%, rgba(56,189,248,0.18), transparent 55%), radial-gradient(ellipse at 10% 90%, rgba(56,189,248,0.08), transparent 50%);"></div>
    <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1.5px); background-size: 32px 32px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
        <div class="flex items-center gap-2 mb-3 text-sky-400/85">
            <ProjectsIcon class="size-4"/>
            <span class="text-[11px] tracking-[0.16em] uppercase font-semibold">{T.eyebrow}</span>
        </div>
        <h2 class="text-white text-3xl md:text-[32px] font-bold tracking-tight">{T.heading}</h2>
        <p class="text-neutral-500 text-sm mt-2 font-sans">{T.sub}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-12">
            {AREAS.map((area) => (
                <a
                    href={getRelativeLocaleUrl(lang, area.href)}
                    class="group flex flex-col rounded-lg border border-neutral-800 bg-neutral-900 overflow-hidden hover:border-sky-500/40 hover:-translate-y-0.5 transition duration-150"
                >
                    <div class={`relative aspect-3/2 flex items-center justify-center overflow-hidden ${serviceColors[area.type]}`}>
                        <div
                            class="absolute inset-0 opacity-25 mix-blend-overlay"
                            style="background-image: url('/img/background.svg'); background-size: cover; background-position: center;"
                        ></div>
                        {area.type === 'bedrock' && (
                            <div class="absolute inset-0 opacity-15" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 31px, rgba(255,255,255,0.18) 31px, rgba(255,255,255,0.18) 32px), repeating-linear-gradient(90deg, transparent, transparent 31px, rgba(255,255,255,0.18) 31px, rgba(255,255,255,0.18) 32px);"></div>
                        )}
                        {area.type === 'unity' && (
                            <>
                                <div class="absolute inset-0 opacity-15" style="background-image: radial-gradient(circle, rgba(255,255,255,0.35) 1px, transparent 1.5px); background-size: 24px 24px;"></div>
                                <div class="absolute inset-0" style="background-image: radial-gradient(ellipse at 50% 20%, rgba(255,255,255,0.10), transparent 55%);"></div>
                            </>
                        )}
                        {area.type === 'flutter' && (
                            <>
                                <div class="absolute inset-0 opacity-25" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 18px, rgba(125,211,252,0.28) 18px, rgba(125,211,252,0.28) 19px, transparent 19px, transparent 38px);"></div>
                                <div class="absolute inset-0 opacity-40" style="background-image: radial-gradient(circle at 80% 25%, rgba(125,211,252,0.30), transparent 45%), radial-gradient(circle at 15% 80%, rgba(2,86,155,0.35), transparent 50%);"></div>
                            </>
                        )}
                        {area.type === 'web' && (
                            <>
                                <div class="absolute inset-0 opacity-50" style="background-image: radial-gradient(ellipse at 100% 0%, rgba(251,146,60,0.40), transparent 55%), radial-gradient(ellipse at 15% 90%, rgba(180,83,9,0.30), transparent 55%);"></div>
                                <div class="absolute inset-0 opacity-50" style="background-image: radial-gradient(circle at 18% 28%, rgba(255,255,255,0.7) 1px, transparent 1.6px), radial-gradient(circle at 72% 78%, rgba(255,255,255,0.5) 1px, transparent 1.6px), radial-gradient(circle at 47% 62%, rgba(255,255,255,0.35) 1px, transparent 1.6px), radial-gradient(circle at 86% 36%, rgba(255,255,255,0.55) 1px, transparent 1.6px), radial-gradient(circle at 30% 80%, rgba(255,255,255,0.4) 1px, transparent 1.6px); background-size: 220px 220px;"></div>
                            </>
                        )}
                        <div class="relative size-16 text-neutral-50 drop-shadow-lg">
                            {area.kind === 'cube'    && <MinecraftWhite class="w-full h-full" />}
                            {area.kind === 'unity'   && <Unity     class="w-full h-full" />}
                            {area.kind === 'flutter' && <Flutter   class="w-full h-full" />}
                            {area.kind === 'astro'   && <AstroIcon class="w-full h-full" />}
                        </div>
                    </div>
                    <div class="flex flex-col grow p-7">
                        <h3 class="text-white text-base font-bold mb-2 tracking-tight">{area.title[lang]}</h3>
                        <p class="text-neutral-400 text-[13px] leading-relaxed font-sans grow mb-5">{area.desc[lang]}</p>
                        <span class="text-sky-400 text-xs">{area.cta[lang]}</span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
