---
import type { ServiceKey } from '../../config/pricing';
import { PRICING, RUSH_MULTIPLIER } from '../../config/pricing';
import { PRICING_ES, localizeConfig } from '../../config/pricing.es';
import { CONTENT_BY_SLUG } from '../../lib/services/content';

import MinecraftWhite from '../../icons/MinecraftWhite.astro';
import Unity          from '../../icons/Unity.astro';
import Flutter        from '../../icons/Flutter.astro';
import AstroIcon      from '../../icons/AstroIcon.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl } from '../../i18n/utils';

interface Props { service: ServiceKey; }
const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const config = lang === 'es' ? localizeConfig(PRICING[service], PRICING_ES[service]) : PRICING[service];
const content = CONTENT_BY_SLUG[service][lang];
const defaultScale = config.scale[0];
const initialMin = defaultScale.range[0];
const initialMax = defaultScale.range[1];
const initialTimeline = defaultScale.timeline;
const formatPrice = (n: number) => `€${n.toLocaleString('en-US')}`;
const rushPct = Math.round((RUSH_MULTIPLIER - 1) * 100);
const formId = `estimator-${service}-page`;

// Add-on cards lay out evenly when the column count divides the toggle count:
// 6 toggles → 2×3, while 4 and 7 stay denser at 4 columns (4, or 4+3).
const addonCols = config.toggles.length % 3 === 0 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';

// Hero copy + FAQs per service, per locale.
const HERO_EN_INTRO = "Pick the scope, scale and add-ons below — the indicative range updates live. Send the brief when you're ready and I'll come back with a fixed quote within 48 hours.";
const HERO_ES_INTRO = "Elige alcance, escala y add-ons abajo; el rango orientativo se actualiza al momento. Mándame el brief cuando quieras y te paso un presupuesto cerrado en 48 horas.";
const HERO: Record<'en' | 'es', Record<ServiceKey, { eyebrow: string; titleA: string; titleB: string; intro: string }>> = {
    en: {
        bedrock:  { eyebrow: 'Minecraft Bedrock · TypeScript',     titleA: 'Configure your', titleB: 'Bedrock add-on.',  intro: HERO_EN_INTRO },
        unity:    { eyebrow: 'Unity · C# · Multi-platform',        titleA: 'Configure your', titleB: 'Unity project.',   intro: HERO_EN_INTRO },
        flutter:  { eyebrow: 'Flutter · iOS + Android · Dart',     titleA: 'Configure your', titleB: 'Flutter app.',     intro: HERO_EN_INTRO },
        websites: { eyebrow: 'Astro · Tailwind · Optional CMS',    titleA: 'Configure your', titleB: 'website.',         intro: HERO_EN_INTRO },
    },
    es: {
        bedrock:  { eyebrow: 'Minecraft Bedrock · TypeScript',     titleA: 'Configura tu', titleB: 'add-on de Bedrock.', intro: HERO_ES_INTRO },
        unity:    { eyebrow: 'Unity · C# · Multiplataforma',       titleA: 'Configura tu', titleB: 'proyecto Unity.',    intro: HERO_ES_INTRO },
        flutter:  { eyebrow: 'Flutter · iOS + Android · Dart',     titleA: 'Configura tu', titleB: 'app Flutter.',       intro: HERO_ES_INTRO },
        websites: { eyebrow: 'Astro · Tailwind · CMS opcional',    titleA: 'Configura tu', titleB: 'web.',               intro: HERO_ES_INTRO },
    },
};

const FAQ_PRICE_EN = { q: 'How is the price decided?', a: "You build a live estimate here — that's the indicative range. After a short message exchange I send a fixed written quote, valid for 14 days. No surprises mid-project." };
const FAQ_PAY_EN   = { q: 'What does payment look like?', a: 'Milestone-based. Small projects upfront, medium projects split start + delivery, large projects split into three. Cancel any phase — you keep the IP for what was paid.' };
const FAQ_PRICE_ES = { q: '¿Cómo se decide el precio?', a: "Montas la estimación aquí en directo — ese es el rango orientativo. Tras un par de mensajes te paso un presupuesto cerrado por escrito, válido 14 días. Sin sorpresas a mitad de proyecto." };
const FAQ_PAY_ES   = { q: '¿Cómo son los pagos?', a: 'Por hitos: los pequeños van por adelantado; los medianos, mitad al empezar y mitad al entregar; los grandes, en tres pagos. Puedes parar en cualquier fase y te quedas con lo que ya esté pagado.' };

const FAQS: Record<'en' | 'es', Record<ServiceKey, { q: string; a: string }[]>> = {
    en: {
        bedrock: [
            FAQ_PRICE_EN, FAQ_PAY_EN,
            { q: 'Do you publish to the Marketplace yourself?', a: 'No — you keep your Partner account and publish under your name. I can join as a developer to help with the submission flow if you want me to.' },
            { q: 'Will it survive future Bedrock updates?',     a: 'Locked to a chosen stable Bedrock release. I re-test against any 2.x breaking update for 30 days post-launch. After that, an optional maintenance plan keeps it current.' },
            { q: "What if my project doesn't fit a tier?",      a: "No problem — describe what you want in the notes and I'll quote the closest fit. Most projects don't map perfectly to a pre-set scale." },
        ],
        unity: [
            FAQ_PRICE_EN, FAQ_PAY_EN,
            { q: 'Do you work alongside our existing team?',    a: 'Yes — happy to plug into an existing Unity project, Slack/Discord, and your sprint cadence. I work as a senior contributor, not a black-box vendor.' },
            { q: 'What about art, audio, and design?',          a: 'Client-provided or commissioned separately. I cover gameplay engineering, tooling, builds, and integrations — not asset production.' },
            { q: 'Who publishes to Steam / mobile stores?',     a: "You. Accounts stay under your name. I help with submission flows and can be added as a developer to streamline the release." },
        ],
        flutter: [
            FAQ_PRICE_EN, FAQ_PAY_EN,
            { q: 'Do I keep the App Store / Play accounts?',    a: 'Yes — they stay with you. Apple Developer ($99/yr) and Google Play ($25 one-time) are on your side. I can be added as a developer to handle signing and submission.' },
            { q: 'What about native iOS / Android features?',   a: "Flutter covers most things. When a feature isn't in a plugin, I write the minimal native bridge (Swift/Kotlin) inside the project — still one codebase to maintain." },
            { q: "Can you start from a Figma design?",          a: "Yes — Figma, Sketch, or just references. If you don't have a design, I can mock the screens in the brief notes and we iterate together." },
        ],
        websites: [
            FAQ_PRICE_EN, FAQ_PAY_EN,
            { q: 'Do I own the code and content?',              a: 'Yes — full source in your GitHub from day one, full IP on final payment. If we use Storyblok, the space gets transferred to your account at handover.' },
            { q: 'Who pays for hosting and the domain?',        a: 'You. Domain (~€12/yr) and host (Vercel/Netlify/Cloudflare Pages — free for the small sites, ~$20/mo Vercel Pro for commercial use) on your side. I set them up and hand over access.' },
            { q: "Can I update the content myself after launch?", a: "If you pick the Storyblok CMS option, yes — visual editor, no code. Otherwise content lives in markdown / config files in the repo and changes need a small deploy." },
        ],
    },
    es: {
        bedrock: [
            FAQ_PRICE_ES, FAQ_PAY_ES,
            { q: '¿Publicas tú en el Marketplace?',                a: 'No — tú mantienes tu cuenta de Partner y publicas a tu nombre. Puedo unirme como desarrollador para ayudarte con el proceso de envío si quieres.' },
            { q: '¿Sobrevivirá a futuras actualizaciones de Bedrock?', a: 'Se fija a una versión estable de Bedrock elegida. Reviso contra cualquier actualización 2.x que rompa algo durante 30 días tras el lanzamiento. Después, un plan de mantenimiento opcional lo mantiene al día.' },
            { q: '¿Y si mi proyecto no encaja en ningún nivel?',  a: 'Sin problema — describe lo que quieres en las notas y te presupuesto lo más parecido. La mayoría de proyectos no encajan perfectamente en una escala predefinida.' },
        ],
        unity: [
            FAQ_PRICE_ES, FAQ_PAY_ES,
            { q: '¿Trabajas junto a nuestro equipo actual?',      a: 'Sí — encantado de integrarme en un proyecto Unity existente, en vuestro Slack/Discord y en vuestra cadencia de sprints. Trabajo como un colaborador senior más, no como un proveedor opaco.' },
            { q: '¿Y el arte, el audio y el diseño?',             a: 'Los aporta el cliente o se encargan aparte. Yo cubro la ingeniería de gameplay, herramientas, builds e integraciones — no la producción de assets.' },
            { q: '¿Quién publica en Steam / tiendas móviles?',    a: 'Tú. Las cuentas quedan a tu nombre. Ayudo con los procesos de envío y se me puede añadir como desarrollador para agilizar el lanzamiento.' },
        ],
        flutter: [
            FAQ_PRICE_ES, FAQ_PAY_ES,
            { q: '¿Conservo las cuentas de App Store / Play?',    a: 'Sí — son tuyas. Apple Developer (99$/año) y Google Play (25$ pago único) corren de tu parte. Se me puede añadir como desarrollador para gestionar la firma y el envío.' },
            { q: '¿Y las funciones nativas de iOS / Android?',    a: 'Flutter cubre la mayoría de cosas. Cuando una función no está en un plugin, escribo el puente nativo mínimo (Swift/Kotlin) dentro del proyecto — sigue siendo un único código que mantener.' },
            { q: '¿Puedes partir de un diseño en Figma?',         a: 'Sí — Figma, Sketch o solo referencias. Si no tienes diseño, puedo bocetar las pantallas a partir de las notas del brief e iteramos juntos.' },
        ],
        websites: [
            FAQ_PRICE_ES, FAQ_PAY_ES,
            { q: '¿Soy dueño del código y el contenido?',         a: 'Sí — todo el código en tu GitHub desde el primer día, propiedad intelectual completa al pago final. Si usamos Storyblok, el espacio se transfiere a tu cuenta en la entrega.' },
            { q: '¿Quién paga el hosting y el dominio?',          a: 'Tú. El dominio (~12€/año) y el hosting (Vercel/Netlify/Cloudflare Pages — gratis para las webs pequeñas, ~20$/mes Vercel Pro para uso comercial) corren de tu parte. Yo los configuro y te entrego los accesos.' },
            { q: '¿Puedo actualizar el contenido yo mismo tras el lanzamiento?', a: 'Si eliges la opción de CMS Storyblok, sí — editor visual, sin código. Si no, el contenido vive en archivos markdown / config del repo y los cambios requieren un pequeño despliegue.' },
        ],
    },
};

